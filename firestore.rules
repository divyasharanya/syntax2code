rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCompany() {
      return isSignedIn() && getUserRole() == 'company';
    }

    // Admin check is purely email-based via the Firebase Auth JWT token.
    // This avoids any dependency on the Firestore `role` field for the admin user,
    // which may be null on first login. Update this email to match VITE_ADMIN_EMAIL.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'divyasaranya0619@gmail.com';
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isOwner(uid);
      // Owner or admin can update any field.
      // Companies may update only the 'points' field (candidate point awards on review).
      allow update: if isOwner(uid) || isAdmin() || (
        isCompany() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
      );
      allow delete: if isAdmin();
    }

    // ── tasks/{taskId} ─────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isCompany() || isAdmin();
      // Company that owns the task or admin can update anything
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.companyId == request.auth.uid
      ) || (
        // Candidates can only increment applicantsCount (no other field changes)
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount'])
      );
      allow delete: if isSignedIn() && (
        resource.data.companyId == request.auth.uid || isAdmin()
      );
    }

    // ── applications/{appId} ───────────────────────────────────────────────
    match /applications/{appId} {
      allow create: if isSignedIn() &&
        request.resource.data.candidateId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.companyId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
      // Allow querying the collection (needed for onSnapshot listeners)
      allow list: if isSignedIn() && (
        request.auth.uid != null
      ) || isAdmin();
    }

    // ── submissions/{subId} ────────────────────────────────────────────────
    match /submissions/{subId} {
      allow create: if isSignedIn() &&
        request.resource.data.candidateId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.companyId == request.auth.uid || isAdmin()
      ) || (
        // Candidates may self-update their own submission to 'Rejected' only.
        // Used for client-side auto-rejection when a task deadline expires.
        // Tightly scoped: only the 'status' field may change, and only to 'Rejected'.
        isSignedIn() &&
        resource.data.candidateId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'Rejected'
      );
      allow delete: if isAdmin();
      // Allow querying the collection (needed for onSnapshot listeners)
      // The where() clauses in queries scope the results — every returned doc
      // is still individually checked against the read rule above.
      allow list: if isSignedIn() || isAdmin();
    }
  }
}
